    "latency_scale_ms": 100.0,
    "max_allowed_recovery_time": 10.0,
    "max_budget": "episode_initial_cloud_budget",
    "max_latency_ms": 500.0,
    "selection_persistence": "run_config_snapshot",
    "target_latency_ms": 50.0
  },
  "task_registry": {
    "train": [
      "train.level_1_read_logs",
